# Codex-compatible OpenAI API
CODEX_API_KEY=replace-with-your-codex-compatible-api-key
CODEX_BASE_URL=https://www.speedyapi.best/v1
CODEX_MODEL=gpt-5.6-terra
CODEX_REASONING_EFFORT=xhigh
# Optional: used only when WeCom does not provide voice.content.
CODEX_TRANSCRIPTION_MODEL=
# `file` is the Chat Completions file content part; use `input_file` only if your provider documents it.
CODEX_FILE_PART_TYPE=file
CODEX_TIMEOUT_MS=120000

BOT_SYSTEM_PROMPT=你是微信群里的智能助手。回答简洁、准确、友善；不知道时明确说明。

# 企业微信智能机器人 URL 回调
WECOM_TOKEN=replace-with-the-token-from-wecom
WECOM_ENCODING_AES_KEY=replace-with-the-43-character-key-from-wecom
# 智能机器人回调通常留空；只有官方协议要求时才填写 receiveid。
WECOM_RECEIVE_ID=
# Needed when callbacks contain only image/file/voice media_id.
WECOM_CORP_ID=
WECOM_CORP_SECRET=
PORT=3000
MAX_HISTORY_MESSAGES=12
MAX_MEDIA_BYTES=10485760
MEDIA_FETCH_TIMEOUT_MS=30000
MAX_FILE_TEXT_CHARS=60000
