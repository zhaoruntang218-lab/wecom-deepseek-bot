# DeepSeek
DEEPSEEK_API_KEY=replace-with-a-new-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional Codex-compatible provider. Use /codex question to route one message.
CODEX_API_KEY=replace-with-your-codex-compatible-api-key
CODEX_BASE_URL=https://www.speedyapi.best/v1
CODEX_MODEL=gpt-5.6-terra
CODEX_REASONING_EFFORT=xhigh
# Set to codex to route all messages there; otherwise DeepSeek remains default.
BOT_DEFAULT_PROVIDER=deepseek

BOT_SYSTEM_PROMPT=你是微信群里的智能助手。回答简洁、准确、友善；不知道时明确说明。

# 企业微信智能机器人 URL 回调
WECOM_TOKEN=replace-with-the-token-from-wecom
WECOM_ENCODING_AES_KEY=replace-with-the-43-character-key-from-wecom
# 智能机器人回调通常留空；只有官方协议要求时才填写 receiveid。
WECOM_RECEIVE_ID=
PORT=3000
MAX_HISTORY_MESSAGES=12
